# QuizRX Frontend Environment Variables
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to version control!

# ============================================
# FIREBASE CONFIGURATION (REQUIRED)
# Get these from Firebase Console > Project Settings
# ============================================
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# ============================================
# API CONFIGURATION
# ============================================
# Backend GraphQL API URL
NEXT_PUBLIC_API_URL=http://localhost:3001/graphql

# Cognitive Service API URL
NEXT_PUBLIC_COGNITIVE_API_URL=http://localhost:8081

# ============================================
# FEATURE FLAGS (optional)
# ============================================
# Enable/disable AI avatar feature
NEXT_PUBLIC_ENABLE_AVATAR=false

# Enable/disable voice synthesis feature
NEXT_PUBLIC_ENABLE_VOICE=false

# Enable/disable payment features
NEXT_PUBLIC_ENABLE_PAYMENTS=false

# ============================================
# THIRD-PARTY INTEGRATIONS (optional)
# ============================================
# HeyGen API for avatar (if ENABLE_AVATAR=true)
NEXT_PUBLIC_HEYGEN_API_KEY=

# ElevenLabs API for voice (if ENABLE_VOICE=true)
NEXT_PUBLIC_ELEVENLABS_API_KEY=

# Stripe publishable key (if ENABLE_PAYMENTS=true)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# ============================================
# ANALYTICS (optional)
# ============================================
NEXT_PUBLIC_GA_TRACKING_ID=
NEXT_PUBLIC_HOTJAR_ID=
